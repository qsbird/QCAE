                record_wire::read_text(record_wire::require(input, RecordFieldId{2}).payload);
            value.forces = records_detail::unpack_references<std::vector<EntityId>>(
                record_wire::require(input, RecordFieldId{3}).payload);
            value.constraints = records_detail::unpack_references<std::vector<EntityId>>(
                record_wire::require(input, RecordFieldId{4}).payload);
            validate_fields(value);
            return std::make_shared<const Value>(std::move(value));
        };
        result.owned_bytes = [](const void* object) {
            const auto& value = *static_cast<const Value*>(object);
            return sizeof(Value) + records_detail::dynamic_bytes(value.id) +
                   records_detail::dynamic_bytes(value.name) +
                   records_detail::dynamic_bytes(value.forces) +
                   records_detail::dynamic_bytes(value.constraints);
        };
        result.references = [](const void* object, const RecordReferenceVisitor& visitor) {
            const auto& value = *static_cast<const Value*>(object);
            static constexpr std::array targets_3{RecordTypeId{4105}};
            for (const auto& item : value.forces)
                visitor(RecordFieldId{3}, item.value, targets_3);
            static constexpr std::array targets_4{RecordTypeId{4106}};
            for (const auto& item : value.constraints)
                visitor(RecordFieldId{4}, item.value, targets_4);
        };
        result.validate = [](const void* object, const DocumentView& view) {
            const auto& value = *static_cast<const Value*>(object);
            validate_fields(value);
            (void)view;
        };
        return result;
    }
};
