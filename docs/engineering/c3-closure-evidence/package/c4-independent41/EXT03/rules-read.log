        RecordTraits<records::BeamSection>::descriptor(),
        RecordTraits<records::Beam>::descriptor(),
        RecordTraits<records::Part>::descriptor(),
        RecordTraits<records::Assembly>::descriptor(),
        RecordTraits<records::EntitySet>::descriptor(),
        RecordTraits<records::IncludeDocument>::descriptor(),
        RecordTraits<records::NodalForce>::descriptor(),
        RecordTraits<records::Constraint>::descriptor(),
        RecordTraits<records::AnalysisDefinition>::descriptor(),
        RecordTraits<records::SourceIdentifier>::descriptor(),
        RecordTraits<records::GeometryLine>::descriptor(),
        RecordTraits<records::Mesh>::descriptor(),
        RecordTraits<records::LoadCase>::descriptor(),
    };
}
