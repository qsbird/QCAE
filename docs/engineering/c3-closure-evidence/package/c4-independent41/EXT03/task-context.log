        QTest::addColumn<bool>("old_success");
        QTest::addColumn<bool>("second_intent");
        QTest::newRow("accepted-H1-queued-H2") << true << true;
        QTest::newRow("accepted-H1-alone") << true << false;
        QTest::newRow("conflicted-H1-queued-H2") << false << true;
