if(QCAE_BUILD_DESKTOP)
  if(NOT QCAE_BUILD_IPC OR NOT QCAE_BUILD_STORAGE)
    message(FATAL_ERROR "Desktop requires QCAE_BUILD_IPC=ON and QCAE_BUILD_STORAGE=ON")
  endif()
  find_package(Qt6 6.10 REQUIRED COMPONENTS Widgets OpenGLWidgets Test)
  find_package(VTK REQUIRED COMPONENTS CommonCore CommonDataModel FiltersSources RenderingCore
    RenderingOpenGL2 InteractionStyle GUISupportQt)
  add_subdirectory(adapters/rendering_vtk)
  add_subdirectory(ui/desktop)
  add_subdirectory(apps/desktop)
  if(BUILD_TESTING)
    find_package(Qt6 6.10 REQUIRED COMPONENTS GuiPrivate)
    add_executable(qcae_qt_text_ledger_probe tests/qt_text_ledger_probe.cpp)
    target_link_libraries(qcae_qt_text_ledger_probe PRIVATE qcae_transport_local Qt6::Widgets)
    qcae_warnings(qcae_qt_text_ledger_probe)
    add_test(NAME qt_text_ledger COMMAND qcae_qt_text_ledger_probe)
    set_tests_properties(qt_text_ledger PROPERTIES TIMEOUT 30 ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
    add_executable(qcae_qt_widget_copy_probe tests/qt_widget_copy_probe.cpp)
    target_link_libraries(qcae_qt_widget_copy_probe PRIVATE qcae_foundation Qt6::Widgets Qt6::GuiPrivate)
    target_include_directories(qcae_qt_widget_copy_probe PRIVATE
      "${CMAKE_CURRENT_SOURCE_DIR}/adapters/rendering_vtk/include"
      "${CMAKE_CURRENT_SOURCE_DIR}/ui/desktop/src")
    qcae_warnings(qcae_qt_widget_copy_probe)
    add_test(NAME qt_widget_copy COMMAND qcae_qt_widget_copy_probe)
    set_tests_properties(qt_widget_copy PROPERTIES TIMEOUT 30 ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
    add_executable(qcae_qt_font_backend_behavior_probe tests/qt_font_backend_behavior_probe.cpp)
    target_link_libraries(qcae_qt_font_backend_behavior_probe PRIVATE Qt6::Gui Qt6::GuiPrivate)
    qcae_warnings(qcae_qt_font_backend_behavior_probe)
    add_executable(qcae_vtk_coordinate_range_tests tests/vtk_coordinate_range_tests.cpp)
    target_link_libraries(qcae_vtk_coordinate_range_tests PRIVATE qcae_vtk_view)
    target_include_directories(qcae_vtk_coordinate_range_tests PRIVATE
      "${CMAKE_CURRENT_SOURCE_DIR}/adapters/rendering_vtk/src")
    qcae_warnings(qcae_vtk_coordinate_range_tests)
    add_test(NAME vtk_coordinate_ranges COMMAND qcae_vtk_coordinate_range_tests)
    add_executable(qcae_vtk_shift_scale_copy_tests tests/vtk_shift_scale_copy_tests.cpp)
    target_link_libraries(qcae_vtk_shift_scale_copy_tests PRIVATE qcae_vtk_view)
    target_include_directories(qcae_vtk_shift_scale_copy_tests PRIVATE
      "${CMAKE_CURRENT_SOURCE_DIR}/adapters/rendering_vtk/src")
    qcae_warnings(qcae_vtk_shift_scale_copy_tests)
    add_test(NAME vtk_shift_scale_copy COMMAND qcae_vtk_shift_scale_copy_tests)
    if(QCAE_C3_QT_SDK_MANIFEST)
      if(NOT EXISTS "${QCAE_C3_QT_SDK_MANIFEST}")
        message(FATAL_ERROR "The Qt SDK observer requires its exact source manifest")
      endif()
      add_executable(qcae_qt_source_copy_probe tests/qt_source_copy_probe.cpp)
