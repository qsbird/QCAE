      if(NOT EXISTS "${QCAE_C3_HARFBUZZ_SDK_MANIFEST}" OR NOT EXISTS "${QCAE_C3_HARFBUZZ_LIBRARY}")
        message(FATAL_ERROR "The isolated HarfBuzz observer needs both its exact manifest and library")
      endif()
      add_test(NAME harfbuzz_source_copy COMMAND Python3::Interpreter
        "${CMAKE_CURRENT_SOURCE_DIR}/tests/harfbuzz_source_copy_probe.py"
        --observed "${QCAE_C3_HARFBUZZ_LIBRARY}" --manifest "${QCAE_C3_HARFBUZZ_SDK_MANIFEST}"
        --report "${CMAKE_BINARY_DIR}/harfbuzz-source-copy-report.json")
      set_tests_properties(harfbuzz_source_copy PROPERTIES TIMEOUT 30)
      if(QCAE_C3_QT_SDK_MANIFEST)
        target_compile_definitions(qcae_c3_qt_source_bridge_tests PRIVATE
          QCAE_C3_HARFBUZZ_SDK_MANIFEST="${QCAE_C3_HARFBUZZ_SDK_MANIFEST}"
          QCAE_C3_HARFBUZZ_LIBRARY="${QCAE_C3_HARFBUZZ_LIBRARY}")
      endif()
    endif()

